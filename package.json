{
    "name": "steph",
    "module": "index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "bun run build && tsc --noEmit && bun run src/index.ts",
        "dev:web": "concurrently 'bun run dev:tui web' 'bun run dev:tailwind'",
        "dev:tui": "tsc --noEmit && bun run --watch src/index.ts",
        "dev:tailwind": "tailwindcss -i ./src/web/input.css -o ./src/web/public/styles.css --watch",
        "build": "bun run build:tailwind",
        "build:tailwind": "tailwindcss -i ./src/web/input.css -o ./src/web/public/styles.css"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "concurrently": "^10.0.4",
        "prettier": "3.9.6"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@elysia/html": "^1.4.1",
        "@elysia/static": "^1.4.11",
        "@tailwindcss/cli": "^4.3.3",
        "elysia": "^1.4.29",
        "tailwindcss": "^4.3.3"
    }
}
