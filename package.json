    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "prettier": "3.9.6"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@elysia/html": "^1.4.1",
        "@elysia/static": "^1.4.11",
        "@tailwindcss/cli": "^4.3.3",
        "elysia": "^1.4.29",
        "tailwindcss": "^4.3.3"
    }
}
